---
import Button from '@/components/common/Button.astro';
import Card from '@/components/common/Card.astro';
import FallingLeaves from '@/components/effects/FallingLeaves.astro';
import FallingPetals from '@/components/effects/FallingPetals.astro';
import FallingSnow from '@/components/effects/FallingSnow.astro';
import HeatShimmer from '@/components/effects/HeatShimmer.astro';
import Layout from '@/components/layout/Layout.astro';
import Highlight from '@/components/common/Highlight.astro';
import Icon from '@/components/common/Icon.astro';
import InstantPhoto from '@/components/common/InstantPhoto.astro';
import PageHero from '@/components/common/PageHero.astro';
import Sunlight from '@/components/effects/Sunlight.astro';
import portrait from '@/assets/home/portrait.jpg.jpeg';
import { getIcon } from '@/lib/icons';
import { withBase } from '@/lib/paths';
import { AUTHOR_NAME, GITHUB_URL, JOB_TITLE, LINKEDIN_URL, SITE_DESCRIPTION, SITE_NAME } from '@/lib/site';

const personSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: AUTHOR_NAME,
  jobTitle: JOB_TITLE,
  url: new URL(withBase('/'), Astro.site).toString(),
  sameAs: [GITHUB_URL, LINKEDIN_URL],
}).replace(/</g, '\\u003c');

const highlights = [
  {
    icon: getIcon('leaf'),
    title: 'Analisis Data & Statistika',
    description: 'Mempelajari statistika deskriptif, teori probabilitas, serta pengolahan data terstruktur.',
  },
  {
    icon: getIcon('sun-moon'),
    title: 'Komputasi & Pemrograman',
    description: 'Mengembangkan logika pemrograman dasar menggunakan Python, R, dan Microsoft Excel.',
  },
  {
    icon: getIcon('article'),
    title: 'Catatan & Proyek Kuliah',
    description: 'Mendokumentasikan tugas kuliah, tulisan ilmiah, dan eksplorasi data secara teratur.',
  },
];
---

<Layout title={SITE_NAME} description={SITE_DESCRIPTION}>
  <script type="application/ld+json" is:inline set:html={personSchema} />
  <FallingLeaves />
  <FallingSnow />
  <FallingPetals />
  <Sunlight />
  <HeatShimmer>
    <main class="content-shell">
      <PageHero title="Home" hideTitle>
        <div
          class:list={[
            'flex',
            'items-center',
            'justify-between',
            'gap-12',
            'max-md:flex-col',
            'max-md:items-start',
            'max-md:gap-8',
          ]}
        >
          <div class="flex flex-col items-start gap-8">
            <h2 class:list={['text-[clamp(3rem,4.5vw,4.25rem)]', 'leading-[1.05]', 'tracking-[-0.02em]']}>
              Halo, saya <Highlight handDrawn>Yesica Sibarani</Highlight>
            </h2>
            <div class="flex flex-wrap gap-4">
              <Button href={withBase('/blog/')}>
                Baca Blog
                <Icon icon={getIcon('arrow-right')} />
              </Button>
              <Button href={withBase('/projects/')} variant="secondary">
                Lihat Proyek
              </Button>
            </div>
          </div>
          <InstantPhoto
            src={portrait}
            alt="Foto profil Yesica Sibarani"
            caption="Statistika 2026"
            loading="eager"
            class:list={['w-full', 'max-w-72', 'sm:max-w-96', 'md:max-w-[19rem]', 'lg:max-w-96']}
          />
        </div>
      </PageHero>

      <section class="section" aria-label="About">
        <div class="flex-column justify-center w-full mt-10">
          <Card>
            <div class="about-prose">
              <p>
                <Highlight bold handDrawn>
                  Tentang Saya
                </Highlight>{' '}
                — Saya adalah mahasiswa baru Program Studi Statistika angkatan 2026 di Universitas Cenderawasih. Saya
                memiliki minat besar pada analisis data, pemodelan statistik, dan pemrograman komputer.
              </p>
              <p>
                Saat ini saya sedang memperdalam keterampilan pengolahan data menggunakan Microsoft Excel, logika dasar
                pemrograman Python, serta penulisan ilmiah untuk mengolah informasi secara akurat dan sistematis.
              </p>
            </div>
          </Card>

          <h2
            id="highlights-heading"
            class:list={['mt-16', 'mb-8', 'text-[clamp(2rem,3.2vw,2.75rem)]', 'leading-[1.12]', 'tracking-[-0.02em]']}
          >
            Fokus & <Highlight handDrawn>Keterampilan</Highlight>
          </h2>
          <ul aria-labelledby="highlights-heading" class="m-0 grid list-none gap-6 p-0 md:grid-cols-3">
            {highlights.map(({ icon, title, description }) => (
              <Card as="li" class="flex min-h-72 flex-col p-8">
                <span
                  class:list={[
                    'inline-flex',
                    'size-14',
                    'items-center',
                    'justify-center',
                    'border-2',
                    'border-ink',
                    'bg-accent',
                    'text-bg',
                    'shadow-[3px_3px_0_0_var(--ink)]',
                  ]}
                >
                  <Icon icon={icon} class="size-7" />
                </span>
                <h3
                  class:list={[
                    'm-0',
                    'mt-6',
                    'text-[1.5rem]',
                    'leading-[1.2]',
                    'font-bold',
                    'tracking-[-0.005em]',
                    'text-ink',
                  ]}
                >
                  {title}
                </h3>
                <p class="mt-3 text-[1.05rem] leading-[1.55] text-ink">{description}</p>
              </Card>
            ))}
          </ul>
          <Card class="mt-14 p-6">
            <div class="flex flex-wrap items-center justify-between gap-4">
              <h2 class="m-0 text-[1.4rem] font-bold text-ink">
                Tahukah <Highlight handDrawn>Kamu?</Highlight>
              </h2>
              <button
                id="btn-fact"
                type="button"
                class="cursor-pointer border-2 border-ink bg-accent px-4 py-2 text-sm font-bold text-bg shadow-[3px_3px_0_0_var(--ink)] transition-transform hover:-translate-y-0.5"
              >
                Acak Fakta Statistika 🎲
              </button>
            </div>
            <p id="fact-text" class="mt-4 text-[1.08rem] leading-relaxed text-ink/90">
              Kata "Statistika" berasal dari bahasa Latin <em>status</em> yang berarti negara, karena awalnya digunakan untuk mencatat data penduduk dan pajak kerajaan!
            </p>
          </Card>

          <script>
            const facts = [
              'Kata "Statistika" berasal dari bahasa Latin "status" yang berarti negara, karena awalnya dipakai untuk sensus penduduk kerajaan.',
              'Dalam kelompok berisi 23 orang saja, peluang ada 2 orang yang berulang tahun di tanggal yang sama sudah lebih dari 50% (Birthday Paradox)!',
              'Bahasa pemrograman Python dinamai bukan dari ular piton, melainkan dari grup komedi Inggris favorit penciptanya: "Monty Python".',
              'Rata-rata (Mean) sangat sensitif terhadap nilai ekstrem (outlier), sedangkan Median tetap kokoh di tengah.',
              'Florence Nightingale bukan hanya perawat legendaris, tetapi juga pelopor visualisasi data statistika modern lewat diagram mawar (Coxcomb chart).',
              'Korelasi tidak selalu berarti sebab-akibat: penjualan es krim dan jumlah orang berenang sama-sama naik di musim panas, bukan karena es krim membuat orang berenang!'
            ];

            document.addEventListener('astro:page-load', () => {
              const btn = document.getElementById('btn-fact');
              const textEl = document.getElementById('fact-text');
              if (!btn || !textEl) return;

              let lastIdx = 0;
              btn.addEventListener('click', () => {
                let nextIdx = Math.floor(Math.random() * facts.length);
                if (nextIdx === lastIdx) nextIdx = (nextIdx + 1) % facts.length;
                lastIdx = nextIdx;
                textEl.textContent = facts[nextIdx];
              });
            });
          </script>
        </div>
      </section>
      <section class="section">
      <Card class="p-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <p id="dynamic-greeting" class="m-0 text-[1.08rem] font-bold text-ink">
            Halo! Selamat datang di ruang digital saya 👋
          </p>
          <span class="border-2 border-ink bg-surface px-3 py-1 text-sm font-bold text-ink">
            📍 Jayapura (WIT): <span id="jayapura-clock">--:--:--</span>
          </span>
        </div>
      </Card>
    </section>

    <script>
      document.addEventListener('astro:page-load', () => {
        const greetEl = document.getElementById('dynamic-greeting');
        const clockEl = document.getElementById('jayapura-clock');
        if (!greetEl || !clockEl) return;

        const updateTime = () => {
          const now = new Date();
          const hour = now.getHours();
          let sapaan = 'Selamat Malam 🌙';
          if (hour >= 4 && hour < 11) sapaan = 'Selamat Pagi ☀️';
          else if (hour >= 11 && hour < 15) sapaan = 'Selamat Siang 🌤️';
          else if (hour >= 15 && hour < 18) sapaan = 'Selamat Sore 🌇';

          greetEl.textContent = `${sapaan}! Terima kasih sudah mampir ke portofolio Yesisca.`;

          const witTime = new Intl.DateTimeFormat('id-ID', {
            timeZone: 'Asia/Jayapura',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hour12: false,
          }).format(now);
          clockEl.textContent = witTime;
        };

        updateTime();
        setInterval(updateTime, 1000);
      });
    </script>
    </main>
  </HeatShimmer>
</Layout>

<style>
  .about-prose p {
    margin-bottom: 1.2rem;
    font-size: 1.3rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--ink) 82%, var(--muted));
  }
</style>
