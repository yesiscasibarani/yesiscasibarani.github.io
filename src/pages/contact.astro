---
import Card from '@/components/common/Card.astro';
import Highlight from '@/components/common/Highlight.astro';
import PageHero from '@/components/common/PageHero.astro';
import Layout from '@/components/layout/Layout.astro';
import { GITHUB_URL } from '@/lib/site';
---

<Layout
  title="Contact — Portofolio Yesica"
  description="Hubungi Yesica Arthadita Sibarani melalui email, GitHub, atau formulir masukan."
>
  <main class="content-shell">
    <PageHero title="Hubungi Saya">
      <p class="mt-4 max-w-2xl text-[1.15rem] leading-relaxed text-ink/85">
        Silakan hubungi saya melalui email, media sosial, atau kirimkan saran dan masukan melalui formulir di bawah ini.
      </p>
      <div class="mt-4 flex flex-col gap-1 text-[1.05rem] text-ink">
        <p class="m-0">
          <strong>Email:</strong>{' '}
          <a href="mailto:jesikasibarani78@gmail.com" class="underline decoration-2 underline-offset-4 hover:text-accent">
            jesikasibarani78@gmail.com
          </a>
        </p>
        <p class="m-0">
          <strong>GitHub:</strong>{' '}
          <a
            href={GITHUB_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="underline decoration-2 underline-offset-4 hover:text-accent"
          >
            https://github.com/yesiscasibarani
          </a>
        </p>
      </div>
    </PageHero>

    <section class="section" aria-label="Formulir Kontak">
      <Card class="p-8">
        <h2 class="m-0 text-[clamp(1.5rem,2.5vw,2rem)] leading-tight tracking-[-0.02em] text-ink">
          Kirim <Highlight handDrawn>Saran & Masukan</Highlight>
        </h2>

        <form
          id="contact-form"
          class="mt-6 flex flex-col gap-5"
          onsubmit="event.preventDefault(); const nama = document.getElementById('c-name').value; const email = document.getElementById('c-email').value; const pesan = document.getElementById('c-msg').value; window.location.href = `mailto:jesikasibarani78@gmail.com?subject=${encodeURIComponent('Pesan Portofolio dari ' + nama)}&body=${encodeURIComponent('Nama: ' + nama + '\nEmail Pengirim: ' + email + '\n\nPesan:\n' + pesan)}`;"
        >
          <div class="flex flex-col gap-1.5">
            <label for="c-name" class="font-bold text-ink">Nama</label>
            <input
              id="c-name"
              type="text"
              required
              placeholder="Nama Anda"
              class="border-2 border-ink bg-bg px-4 py-3 text-ink focus:outline-none"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="c-email" class="font-bold text-ink">Email</label>
            <input
              id="c-email"
              type="email"
              required
              placeholder="email@contoh.com"
              class="border-2 border-ink bg-bg px-4 py-3 text-ink focus:outline-none"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="c-msg" class="font-bold text-ink">Pesan</label>
            <textarea
              id="c-msg"
              rows="5"
              required
              placeholder="Tulis pesan atau masukan Anda..."
              class="border-2 border-ink bg-bg px-4 py-3 text-ink focus:outline-none"
            ></textarea>
          </div>

          <div class="mt-2">
            <button
              type="submit"
              class="inline-flex cursor-pointer items-center gap-2 border-2 border-ink bg-accent px-6 py-3 font-bold text-bg shadow-[3px_3px_0_0_var(--ink)] transition-transform hover:-translate-y-0.5"
            >
              Kirim Pesan via Email
            </button>
          </div>
        </form>
      </Card>
    </section>
  </main>
</Layout>