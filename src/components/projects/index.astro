---
import type { ProjectLink } from '@/lib/projects';
import ProjectCard from './ProjectCard.astro';

interface Project {
  name: string;
  description: string;
  technologies: string[];
  links: ProjectLink[];
  isCooking?: boolean;
}

const projects: Project[] = [
  {
    name: 'Pengolahan Data & Tabel Microsoft Excel',
    description:
      'Praktik merapikan data terstruktur, penerapan rumus logika, dan ringkasan perhitungan dasar. Proyek praktik mengolah data terstruktur menggunakan Microsoft Excel untuk melatih ketelitian dan analisis data.',
    technologies: ['Excel'],
    links: [{ kind: 'github', url: 'https://github.com' }],
  },
  {
    name: 'Tugas Komputasi & Logika Dasar Python',
    description:
      'Pengenalan pemrograman Python untuk perhitungan matematis dan konsep statistika deskriptif. Tugas kuliah yang berfokus pada pemahaman logika dasar Python untuk membantu perhitungan data kuantitatif.',
    technologies: ['Python'],
    links: [{ kind: 'github', url: 'https://github.com' }],
  },
  {
    name: 'Esai Akademik & Analisis Kritis',
    description:
      'Penulisan esai terstruktur yang melatih kemampuan menyusun argumen logis dan komunikasi ilmiah secara tertulis.',
    technologies: ['Esai'],
    links: [{ kind: 'github', url: 'https://github.com' }],
  },
];
---

<section class="section grid gap-8 md:grid-cols-2" aria-label="Projects">
  {projects.map((project) => (
    <ProjectCard {...project} />
  ))}
</section>
