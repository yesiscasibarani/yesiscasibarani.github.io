---
import ProjectCard, { type Props as Project } from './ProjectCard.astro';

const projects: Project[] = [
  {
    title: 'Pengolahan & Analisis Data Menggunakan Microsoft Excel',
    description:
      'Latihan pengolahan dataset statistik deskriptif, penggunaan rumus fungsi logika, serta penyajian tabel dan grafik informasi yang terstruktur.',
    technologies: ['Microsoft Excel', 'Statistika Deskriptif', 'Analisis Data'],
    links: [
      {
        kind: 'demo',
        url: 'https://docs.google.com/spreadsheets/d/1IFu7rXjpEERTvRGsVvmrAulLxqaPNnk3/edit?usp=drivesdk&ouid=113481309200647202349&rtpof=true&sd=true',
      },
    ],
  },
  {
    title: 'Komputasi Dasar & Logika Algoritma dengan Python',
    description:
      'Implementasi struktur kontrol percabangan, perulangan, dan perhitungan matematis dasar menggunakan bahasa pemrograman Python.',
    technologies: ['Python', 'Algoritma', 'Pemrograman'],
    links: [
      {
        kind: 'demo',
        url: 'https://drive.google.com/file/d/1DuWEXf6tJ-o1UH3YYp5PMjAB5rial6Q-/view?usp=sharing',
      },
    ],
  },
  {
    title: 'Penulisan Karya Ilmiah & Esai Akademik',
    description:
      'Penyusunan esai akademik dan kajian literatur terstruktur terkait penerapan ilmu statistika dan analisis kuantitatif dalam pemecahan masalah.',
    technologies: ['Esai Akademik', 'Literasi Data', 'Statistika'],
    links: [
      {
        kind: 'demo',
        url: 'https://drive.google.com/file/d/1hr0MgMfwHW6y_DHoc_sCR2U3_beW4ot7/view?usp=drivesdk',
      },
    ],
  },
];
---

<section class="section grid gap-8 md:grid-cols-2" aria-label="Projects">
  {projects.map((project) => <ProjectCard {...project} />)}
</section>